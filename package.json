{
     "name": "@punyts/state-sync",
     "version": "0.5.0",
     "publishConfig": {
          "access": "public"
     },
     "type": "module",
     "description": "State sync for @punyts/state: changes, the sync protocol messages, change capture, the sync client and its local store, and the authority",
     "main": "dist/index.js",
     "module": "dist/index.js",
     "types": "dist/index.d.ts",
     "exports": {
          ".": {
               "types": "./dist/index.d.ts",
               "default": "./dist/index.js"
          },
          "./authority": {
               "types": "./dist/authority/index.d.ts",
               "default": "./dist/authority/index.js"
          }
     },
     "scripts": {
          "clean": "bash ../../bin/clean.sh .",
          "typecheck": "tsc -p tsconfig.build.json --noEmit",
          "build": "npm run typecheck && bash ../../bin/build.sh . tsc -b tsconfig.build.json",
          "test": "npm run test:run",
          "test:run": "vitest run",
          "test:watch": "vitest --watch",
          "test:cov": "vitest run --coverage",
          "test:browser": "vitest run --config vitest.browser.config.ts"
     },
     "keywords": [],
     "author": "",
     "license": "MIT",
     "dependencies": {
          "@punyts/core": "^1.0.0",
          "@punyts/state": "^1.2.0"
     },
     "devDependencies": {
          "@vitest/browser-playwright": "^4.1.10",
          "playwright": "^1.61.1",
          "typescript": "^5.9.3",
          "vitest": "^4.1.10"
     }
}
